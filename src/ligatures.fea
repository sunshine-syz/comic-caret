# Coding ligatures, merged into the SFD by tools/add_ligatures.py; rerun it after editing.
#
# The lookups in `feature calt` run in order, and an earlier one claims its glyphs first.
# Every lookup is named lig_* so the generator can find and replace it.
#
# FontForge crashes while saving an `rsub` rule made only of bare glyph names, so each rsub
# rule writes its input glyph as a one-glyph class.

languagesystem DFLT dflt;
languagesystem latn dflt;

# Every glyph that shows an operator character, plain or already substituted. The fixed
# ligatures fire only when neither neighbour is in this class.
@Op = [exclam numbersign ampersand asterisk plus hyphen period slash colon less equal greater
  question bar asciitilde underscore
  LIG colon.eq
  hyphen.sta hyphen.mid hyphen.end equal.sta equal.mid equal.end
  underscore.sta underscore.mid underscore.end numbersign.sta numbersign.mid numbersign.end
  asciitilde.sta asciitilde.mid asciitilde.end asciitilde.mid.low asciitilde.end.low
  less.arrow greater.arrow less.darrow greater.darrow
  less.warrow greater.warrow greater.warrow.low less.dtail greater.dtail
  less.twohead greater.twohead less.shaft greater.shaft less.comment exclam.tight_r
  exclam_equal.liga exclam_equal_equal.liga equal_equal_equal.liga less_equal.liga
  greater_equal.liga bar_greater.liga less_bar.liga less_bar_greater.liga less_greater.liga
  colon.tight_r period.tight_r ampersand.tight_r plus.tight_r slash.tight_r
  asterisk.tight_r less.tight_r greater.tight_r question.tight_r bar.tight_r equal.tight_r
  colon.tight_l period.tight_l ampersand.tight_l plus.tight_l slash.tight_l
  asterisk.tight_l less.tight_l greater.tight_l question.tight_l bar.tight_l equal.tight_l];

# The glyphs of one arrow-and-run family; a run or arrow never starts right after one.
@HyphenRun = [hyphen less greater hyphen.sta hyphen.mid hyphen.end less.arrow greater.arrow
  less.twohead greater.twohead less.shaft greater.shaft];
@EqualRun = [equal less greater equal.sta equal.mid equal.end less.darrow greater.darrow];
# FontForge's feature parser drops the first glyph of a range written A-Z; A - Z keeps it.
# What starts a shell heredoc's delimiter after <<-: EOF 'EOF' "EOF" \EOF.
@Delimiter = [A - Z a - z underscore quotesingle quotedbl backslash];
# A digit after <- makes it a minus sign: x<-1 is x < -1.
@Digit = [zero one two three four five six seven eight nine];
# What a name ends in. /* or /** after one is a path (src/*), */ before one a step in a cron
# field (*/5), and >> or >>> after one closes generics (Vec<Vec<u8>>): none is an operator.
@Word = [A - Z a - z @Digit underscore];
# What generics close after: Vec<u8>> Box<dyn Fn()>> Vec<[u8; 4]>>. They never close right
# before a name or a number, as a shift without spaces does: cin>>n, x>>1, a>>>0.
@Operand = [@Word parenright bracketright];
# What ends a TypeScript property name before its optional ?: : name?: T, [K in keyof T]?: T.
@PropertyEnd = [@Word dollar bracketright];
# What follows a < that opens an HTML tag or comment: <p </p <!--.
@TagStart = [A - Z a - z slash exclam];
# What an HTML element's name is made of: <p> <h1> <blockquote>.
@TagName = [A - Z a - z zero one two three four five six seven eight nine];
# What comes before the > that closes a tag: <p> <h1> <br/> alt="x" alt='x'.
@TagEnd = [@TagName slash quotedbl quotesingle];

# Single substitutions, called from the chain rules below.
lookup lig_sta {
  sub [hyphen equal underscore numbersign asciitilde]
   by [hyphen.sta equal.sta underscore.sta numbersign.sta asciitilde.sta];
} lig_sta;
lookup lig_mid {
  sub [hyphen equal underscore numbersign asciitilde]
   by [hyphen.mid equal.mid underscore.mid numbersign.mid asciitilde.mid];
} lig_mid;
lookup lig_end {
  sub [hyphen equal underscore numbersign asciitilde]
   by [hyphen.end equal.end underscore.end numbersign.end asciitilde.end];
} lig_end;
lookup lig_mid_low { sub asciitilde by asciitilde.mid.low; } lig_mid_low;
lookup lig_end_low { sub asciitilde by asciitilde.end.low; } lig_end_low;
lookup lig_arrow { sub [less greater] by [less.arrow greater.arrow]; } lig_arrow;
lookup lig_darrow { sub [less greater] by [less.darrow greater.darrow]; } lig_darrow;
lookup lig_warrow { sub [less greater] by [less.warrow greater.warrow]; } lig_warrow;
lookup lig_warrow_low { sub greater by greater.warrow.low; } lig_warrow_low;
lookup lig_dtail { sub [less greater] by [less.dtail greater.dtail]; } lig_dtail;
lookup lig_twohead { sub [less greater] by [less.twohead greater.twohead]; } lig_twohead;
lookup lig_shaft { sub [less greater] by [less.shaft greater.shaft]; } lig_shaft;
lookup lig_comment { sub [less exclam] by [less.comment exclam.tight_r]; } lig_comment;
lookup lig_spacer { sub [exclam less greater bar equal] by LIG; } lig_spacer;
lookup lig_plain {
  sub [hyphen.sta hyphen.end underscore.sta underscore.end]
   by [hyphen hyphen underscore underscore];
} lig_plain;
lookup lig_exclam_equal { sub equal by exclam_equal.liga; } lig_exclam_equal;
lookup lig_exclam_equal_equal { sub equal by exclam_equal_equal.liga; } lig_exclam_equal_equal;
lookup lig_equal_equal_equal { sub equal by equal_equal_equal.liga; } lig_equal_equal_equal;
lookup lig_colon_eq { sub colon by colon.eq; } lig_colon_eq;
lookup lig_less_equal { sub equal by less_equal.liga; } lig_less_equal;
lookup lig_greater_equal { sub equal by greater_equal.liga; } lig_greater_equal;
lookup lig_bar_greater { sub greater by bar_greater.liga; } lig_bar_greater;
lookup lig_less_bar { sub bar by less_bar.liga; } lig_less_bar;
lookup lig_less_bar_greater { sub greater by less_bar_greater.liga; } lig_less_bar_greater;
lookup lig_less_greater { sub greater by less_greater.liga; } lig_less_greater;
lookup lig_tight_r {
  sub [colon period ampersand plus slash asterisk less greater question bar equal]
   by [colon.tight_r period.tight_r ampersand.tight_r plus.tight_r slash.tight_r
       asterisk.tight_r less.tight_r greater.tight_r question.tight_r bar.tight_r equal.tight_r];
} lig_tight_r;
lookup lig_tight_l {
  sub [colon period ampersand plus slash asterisk less greater question bar equal]
   by [colon.tight_l period.tight_l ampersand.tight_l plus.tight_l slash.tight_l
       asterisk.tight_l less.tight_l greater.tight_l question.tight_l bar.tight_l equal.tight_l];
} lig_tight_l;

feature calt {

  # 1. != !== := come first, so their = never join a run. Like every fixed ligature, they
  #    need a non-operator on both sides, which also keeps !=== and :== plain.
  lookup lig_not_equal {
    ignore sub @Op exclam' equal equal;
    ignore sub exclam' equal equal @Op;
    sub exclam' lookup lig_spacer equal' lookup lig_spacer equal' lookup lig_exclam_equal_equal;
    ignore sub @Op exclam' equal;
    ignore sub exclam' equal @Op;
    sub exclam' lookup lig_spacer equal' lookup lig_exclam_equal;
  } lig_not_equal;

  lookup lig_colon_equal {
    ignore sub @Op colon' equal;
    ignore sub colon' equal @Op;
    sub colon' lookup lig_colon_eq equal;
  } lig_colon_equal;

  # === as three bars, as both references draw it and as !== has them, so it differs from ==
  # by more than its length, also beside another operator (a===-1, x===+y). A longer run
  # (setext headings, conflict markers), an arrow (<===, ===>) and a table's border (+===+)
  # stay one line.
  lookup lig_triple_equal {
    ignore sub [equal exclam colon less greater] equal' equal equal;
    ignore sub equal' equal equal [equal less greater];
    ignore sub [plus bar] equal' equal equal [plus bar];
    sub equal' lookup lig_spacer equal' lookup lig_spacer equal' lookup lig_equal_equal_equal;
  } lig_triple_equal;

  # >=> <=< as a double arrow with a tail: the second > or < is its head, the first its tail.
  lookup lig_fish {
    ignore sub @Op greater' equal greater;
    ignore sub greater' equal greater @Op;
    sub greater' lookup lig_dtail equal' lookup lig_mid greater' lookup lig_darrow;
    ignore sub @Op less' equal less;
    ignore sub less' equal less @Op;
    sub less' lookup lig_darrow equal' lookup lig_mid less' lookup lig_dtail;
  } lig_fish;

  # 2. Arrows and runs of - and =. Built left to right: a head, then pieces that continue
  #    from the glyph before, then a closing head. The unwind lookups then walk right to
  #    left and turn a malformed run back into plain glyphs, however long it is: a head or
  #    end touching more of the run reverts, then every piece before a reverted glyph.
  #    A doubled - head (<<- ->>) draws both heads in its outer cell and a shaft in the
  #    inner one, except in a shell heredoc (<<-EOF). In <!-- the < is an arrow of its own
  #    and the -- runs on; it may follow the > that ends a tag or an arrow (</p><!--
  #    --><!--). An arrow's head stays before a tag, as in --><p>, and so does <!--, as in
  #    <!--<div>-->. Though >- is otherwise an inward head, a run or arrow may start right
  #    after a short tag (<code>--help, </p>--->, <br/>--); after any other > that may end a
  #    tag, as in <a href="x">-->, only --> may, which keeps a>--b plain.
  lookup lig_hyphen_build {
    sub [greater greater.arrow] less' lookup lig_comment exclam' lookup lig_comment hyphen
      hyphen;
    ignore sub @Op less' exclam hyphen hyphen;
    sub less' lookup lig_comment exclam' lookup lig_comment hyphen hyphen;
    ignore sub @HyphenRun less' less hyphen;
    ignore sub less' less hyphen @Delimiter;
    sub less' lookup lig_twohead less hyphen;
    sub less.twohead less' lookup lig_shaft;
    ignore sub @HyphenRun less' hyphen;
    ignore sub less' hyphen @Digit;
    sub less' lookup lig_arrow hyphen;
    sub [less.arrow less.shaft hyphen.sta hyphen.mid] hyphen' lookup lig_mid [hyphen greater];
    sub [less.arrow less.shaft hyphen.sta hyphen.mid] hyphen' lookup lig_end;
    # A short tag opens (<p>), closes (</p>) or closes itself (<br/>). The rules cover names of
    # up to 10 letters and digits, enough for HTML's longest (blockquote, figcaption); a longer
    # name or one with a hyphen joins only as -->.
    sub less @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName @TagName @TagName @TagName greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      greater hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less slash @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      @TagName @TagName greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName slash greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName slash greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName slash greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName slash greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName slash greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName slash greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName slash greater
      hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName slash
      greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      slash greater hyphen' lookup lig_sta [hyphen greater];
    sub less @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName @TagName
      @TagName slash greater hyphen' lookup lig_sta [hyphen greater];
    sub @TagEnd greater hyphen' lookup lig_sta hyphen greater;
    ignore sub @HyphenRun hyphen';
    sub hyphen' lookup lig_sta [hyphen greater];
    sub [hyphen.sta hyphen.mid] greater' lookup lig_shaft greater;
    sub greater.shaft greater' lookup lig_twohead;
    sub [hyphen.sta hyphen.mid] greater' lookup lig_arrow;
  } lig_hyphen_build;

  lookup lig_hyphen_unwind {
    rsub [greater.twohead]' [hyphen less greater] by greater;
    rsub [greater.shaft]' [greater] by greater;
    # A head before a tag becomes itself, which keeps the next rule from reverting it.
    rsub [greater.arrow]' [less] @TagStart by greater.arrow;
    rsub [greater.arrow]' [hyphen less greater] by greater;
    # <!-- before a tag keeps its run's end, which keeps the next rule from reverting it.
    rsub exclam.tight_r hyphen.sta [hyphen.end]' [less] by hyphen.end;
    rsub [hyphen.end]' less by hyphen;
    rsub [hyphen.mid]' [hyphen greater] by hyphen;
    rsub [hyphen.sta]' [hyphen greater] by hyphen;
    rsub [less.shaft]' [hyphen] by less;
    rsub [less.twohead]' [less] by less;
    rsub [less.arrow]' [hyphen] by less;
    rsub [exclam.tight_r]' [hyphen] by exclam;
    rsub [less.comment]' [exclam] by less;
  } lig_hyphen_unwind;

  # A left-only = arrow needs two =, since <= alone is ≤. An = run right after ! or : stays
  # plain, so !=== and :== show no join. <=> is no arrow but C++'s, PHP's, Ruby's and Perl's
  # comparison: it tightens as a three (6.); <==> is an arrow.
  lookup lig_equal_build {
    ignore sub @EqualRun less' equal;
    ignore sub less' equal greater;
    sub less' lookup lig_darrow equal [equal greater];
    sub [less.darrow equal.sta equal.mid] equal' lookup lig_mid [equal greater];
    sub [less.darrow equal.sta equal.mid] equal' lookup lig_end;
    ignore sub [@EqualRun exclam colon] equal';
    sub equal' lookup lig_sta [equal greater];
    sub [equal.sta equal.mid] greater' lookup lig_darrow;
  } lig_equal_build;

  lookup lig_equal_unwind {
    rsub [greater.darrow]' [less] @TagStart by greater.darrow;  # as in lig_hyphen_unwind
    rsub [greater.darrow]' [equal less greater] by greater;
    rsub [equal.end]' less by equal;
    rsub [equal.mid]' [equal greater] by equal;
    rsub [equal.sta]' [equal greater] by equal;
    rsub [less.darrow]' [equal] by less;
  } lig_equal_unwind;

  # 3. <= >=, exactly two characters; <== was taken as an arrow above.
  lookup lig_or_equal {
    ignore sub @Op less' equal;
    ignore sub less' equal @Op;
    sub less' lookup lig_spacer equal' lookup lig_less_equal;
    ignore sub @Op greater' equal;
    ignore sub greater' equal @Op;
    sub greater' lookup lig_spacer equal' lookup lig_greater_equal;
  } lig_or_equal;

  # 4. Runs of _ # ~, whatever their neighbours. ~ pieces alternate: after one that ends
  #    high (.sta, .mid.low) comes one that starts high (.mid, .end), and the reverse. A <
  #    before a ~ run, or a > after one, is a wave arrow's head, the < only when no operator
  #    comes before it and the > only when none follows it; a < head ends high. A run whose
  #    > is no head has no < head either: <~>= is plain, as ~>= is, and <~~>= keeps only the
  #    ~~ run of ~~>=.
  lookup lig_runs {
    sub [underscore.sta underscore.mid] underscore' lookup lig_mid underscore;
    sub [underscore.sta underscore.mid] underscore' lookup lig_end;
    sub underscore' lookup lig_sta underscore;
    sub [numbersign.sta numbersign.mid] numbersign' lookup lig_mid numbersign;
    sub [numbersign.sta numbersign.mid] numbersign' lookup lig_end;
    sub numbersign' lookup lig_sta numbersign;
    ignore sub @Op less' asciitilde;
    sub less' lookup lig_warrow asciitilde;
    sub [asciitilde.sta asciitilde.mid.low less.warrow] asciitilde' lookup lig_end greater @Op;
    sub asciitilde.mid asciitilde' lookup lig_end_low greater @Op;
    sub [asciitilde.sta asciitilde.mid.low less.warrow] asciitilde' lookup lig_mid
      [asciitilde greater];
    sub [asciitilde.sta asciitilde.mid.low less.warrow] asciitilde' lookup lig_end;
    sub asciitilde.mid asciitilde' lookup lig_mid_low [asciitilde greater];
    sub asciitilde.mid asciitilde' lookup lig_end_low;
    ignore sub asciitilde' greater @Op;
    # Before a version, as in Ruby's and Terraform's "~> 4.0", ~> means "at least, within".
    ignore sub asciitilde' greater @Digit;
    ignore sub asciitilde' greater space @Digit;
    sub asciitilde' lookup lig_sta [asciitilde greater];
    sub [asciitilde.sta asciitilde.mid.low] greater' lookup lig_warrow;
    sub asciitilde.mid greater' lookup lig_warrow_low;
  } lig_runs;

  # The < head is set before the run's end is known, so a run that ends in a plain > is
  # unwound right to left, however long it is, and built again without heads: back to its
  # .sta, which the rebuild carries on from, or past its < head to plain glyphs.
  lookup lig_wave_unwind {
    rsub [asciitilde.end]' [greater] by asciitilde;
    rsub [asciitilde.end.low]' [greater] by asciitilde;
    rsub [asciitilde.mid]' [asciitilde] by asciitilde;
    rsub [asciitilde.mid.low]' [asciitilde] by asciitilde;
    rsub [less.warrow]' [asciitilde] by less;
  } lig_wave_unwind;

  lookup lig_wave_rebuild {
    sub [asciitilde.sta asciitilde.mid.low] asciitilde' lookup lig_mid asciitilde;
    sub [asciitilde.sta asciitilde.mid.low] asciitilde' lookup lig_end;
    sub asciitilde.mid asciitilde' lookup lig_mid_low asciitilde;
    sub asciitilde.mid asciitilde' lookup lig_end_low;
    sub asciitilde' lookup lig_sta asciitilde;
  } lig_wave_rebuild;

  # A run of exactly two - or _ goes back to two characters, so --help, i--, -- comments and
  # __init__ count as typed; three or more join, and <!-- keeps its run.
  lookup lig_two_plain {
    ignore sub exclam.tight_r hyphen.sta' hyphen.end;
    sub hyphen.sta' lookup lig_plain hyphen.end' lookup lig_plain;
    sub underscore.sta' lookup lig_plain underscore.end' lookup lig_plain;
  } lig_two_plain;

  # 5. Pipes, and <> as a diamond.
  lookup lig_pipes {
    ignore sub @Op less' bar greater;
    ignore sub less' bar greater @Op;
    sub less' lookup lig_spacer bar' lookup lig_spacer greater' lookup lig_less_bar_greater;
    ignore sub @Op bar' greater;
    ignore sub bar' greater @Op;
    sub bar' lookup lig_spacer greater' lookup lig_bar_greater;
    ignore sub @Op less' bar;
    ignore sub less' bar @Op;
    sub less' lookup lig_spacer bar' lookup lig_less_bar;
    ignore sub @Op bar' bar bar;
    ignore sub bar' bar bar @Op;
    sub bar' lookup lig_tight_r bar bar' lookup lig_tight_l;
    ignore sub @Op bar' bar;
    ignore sub bar' bar @Op;
    sub bar' lookup lig_tight_r bar' lookup lig_tight_l;
  } lig_pipes;

  # <> stays a diamond: Java's diamond operator is named for it, and in SQL's a <> b the shape
  # stands for nothing else.
  lookup lig_diamond {
    ignore sub @Op less' greater;
    ignore sub less' greater @Op;
    sub less' lookup lig_spacer greater' lookup lig_less_greater;
  } lig_diamond;

  # 6. Tightened threes, their outer glyphs moved in and the middle one left in place, then
  #    tightened pairs. The threes come first: a pair's ignore rules would claim them. An =
  #    may close << >> (<<= >>=) or open << (=<<), as in C's shifts and Haskell's binds; ///
  #    and /** open doc comments, so they tighten as // and /* do, and a comment opener
  #    tightens before the ! or < that marks a doc comment (//! /*! ///< /**<). None tightens
  #    beside a @Word where it is no operator there. .. tightens only between two names or
  #    numbers, a range (0..n), so a path (../, cd ..) stays as typed.
  lookup lig_tight {
    ignore sub @Op slash' slash slash;
    sub slash' lookup lig_tight_r slash slash' lookup lig_tight_l [exclam less];
    ignore sub slash' slash slash @Op;
    sub slash' lookup lig_tight_r slash slash' lookup lig_tight_l;
    ignore sub @Word slash' asterisk asterisk;
    ignore sub @Op slash' asterisk asterisk;
    sub slash' lookup lig_tight_r asterisk asterisk' lookup lig_tight_l [exclam less];
    ignore sub slash' asterisk asterisk @Op;
    sub slash' lookup lig_tight_r asterisk asterisk' lookup lig_tight_l;
    ignore sub @Op period' period period;
    ignore sub period' period period @Op;
    sub period' lookup lig_tight_r period period' lookup lig_tight_l;
    ignore sub @Op period' period [equal less];
    ignore sub period' period [equal less] @Op;
    sub period' lookup lig_tight_r period [equal less]' lookup lig_tight_l;
    ignore sub @Op ampersand' ampersand ampersand;
    ignore sub ampersand' ampersand ampersand @Op;
    sub ampersand' lookup lig_tight_r ampersand ampersand' lookup lig_tight_l;
    ignore sub @Op less' less [less equal];
    ignore sub less' less [less equal] @Op;
    sub less' lookup lig_tight_r less [less equal]' lookup lig_tight_l;
    ignore sub @Op greater' greater [greater equal];
    ignore sub greater' greater [greater equal] @Op;
    sub @Operand greater' lookup lig_tight_r greater greater' lookup lig_tight_l @Word;
    ignore sub @Operand greater' greater greater;
    sub greater' lookup lig_tight_r greater [greater equal]' lookup lig_tight_l;
    ignore sub @Op equal' less less;
    ignore sub equal' less less @Op;
    sub equal' lookup lig_tight_r less less' lookup lig_tight_l;
    ignore sub @Op less' [dollar asterisk equal] greater;
    ignore sub less' [dollar asterisk equal] greater @Op;
    sub less' lookup lig_tight_r [dollar asterisk equal] greater' lookup lig_tight_l;
    sub @Word period' lookup lig_tight_r period' lookup lig_tight_l @Word;
    ignore sub @Op colon' colon;
    ignore sub colon' colon @Op;
    sub colon' lookup lig_tight_r colon' lookup lig_tight_l;
    ignore sub @Op ampersand' ampersand;
    ignore sub ampersand' ampersand @Op;
    sub ampersand' lookup lig_tight_r ampersand' lookup lig_tight_l;
    ignore sub @Op plus' plus;
    ignore sub plus' plus @Op;
    sub plus' lookup lig_tight_r plus' lookup lig_tight_l;
    ignore sub @Op slash' slash;
    sub slash' lookup lig_tight_r slash' lookup lig_tight_l [exclam less];
    ignore sub slash' slash @Op;
    sub slash' lookup lig_tight_r slash' lookup lig_tight_l;
    ignore sub @Word slash' asterisk;
    ignore sub @Op slash' asterisk;
    sub slash' lookup lig_tight_r asterisk' lookup lig_tight_l [exclam less];
    ignore sub slash' asterisk @Op;
    sub slash' lookup lig_tight_r asterisk' lookup lig_tight_l;
    ignore sub @Op asterisk' slash;
    ignore sub asterisk' slash @Op;
    ignore sub asterisk' slash @Word;
    sub asterisk' lookup lig_tight_r slash' lookup lig_tight_l;
    ignore sub @Op less' less;
    ignore sub less' less @Op;
    sub less' lookup lig_tight_r less' lookup lig_tight_l;
    ignore sub @Op greater' greater;
    ignore sub greater' greater @Op;
    sub @Operand greater' lookup lig_tight_r greater' lookup lig_tight_l @Word;
    ignore sub @Operand greater' greater;
    sub greater' lookup lig_tight_r greater' lookup lig_tight_l;
    ignore sub @Op question' question;
    ignore sub question' question @Op;
    sub question' lookup lig_tight_r question' lookup lig_tight_l;
    # ?. tightens after a name too, as JavaScript's optional chaining a?.b does; Rust's x?.y,
    # ? then a field, can't be told apart from it.
    ignore sub @Op question' [period colon];
    ignore sub question' [period colon] @Op;
    ignore sub @PropertyEnd question' colon;
    sub question' lookup lig_tight_r [period colon]' lookup lig_tight_l;
  } lig_tight;

} calt;
